---
const projects = [
  {
    name: "Hestia",
    blurb: "Inventory & order management system",
    tags: ["Node.js", "Express", "PostgreSQL", "React"],
    live: "https://hestia-eosin.vercel.app/login",
    repo: "https://github.com/Rizzshen/hestia"
  },
  {
    name: "Kharcha",
    blurb: "Personal finance & expense tracker",
    tags: ["Full-Stack", "REST API", "Collaborative"],
    live: "https://kharcha-omega.vercel.app/",
    repo: "https://github.com/sleepyydesu/Kharcha"
  }
];
---
<section id="projects" class="reveal">
  <h2>Projects</h2>
<div class="row-list">
  {projects.map((p, i) => (
    <article class="row project-row">
      <span class="project-index">{String(i + 1).padStart(2, "0")}</span>
      <div>
        <h3>{p.name}</h3>
        <p>{p.blurb}</p>
        <div class="row-meta">
          <div class="row-tags">
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          <div class="row-links">
            <a href={p.live} target="_blank" rel="noopener" class="accent">Live ↗</a>
            <a href={p.repo} target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </div>
      </div>
    </article>
  ))}
</div>
</section>
