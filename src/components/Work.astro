---
const projects = [
  {
    name: "Hestia",
    blurb: "Inventory & order management system",
    tags: ["Node.js", "Express", "PostgreSQL", "React"],
    live: "https://hestia-eosin.vercel.app/login",
    repo: "https://github.com/Rizzshen/hestia"
  },
  {
    name: "Kharcha",
    blurb: "Personal finance & expense tracker",
    tags: ["Full-Stack", "REST API", "Collaborative"],
    live: "https://kharcha-omega.vercel.app/",
    repo: "https://github.com/sleepyydesu/Kharcha"
  }
];
---
<section id="work" class="reveal">
  <h2>Selected Work</h2>
  <div style="margin-top: 3rem; display: flex; flex-direction: column; gap: 1px; background: var(--surface-raised);">
    {projects.map((p) => (
      <article style="background: var(--bg); padding: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h3>{p.name}</h3>
          <p style="margin-top: 0.25rem;">{p.blurb}</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-end;">
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end;">
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          <div style="display: flex; gap: 1rem;">
            <a href={p.live} target="_blank" rel="noopener" class="accent">Live</a>
            <a href={p.repo} target="_blank" rel="noopener">GitHub</a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
