---
const links = [
  { href: "#projects", label: "Projects" },
  { href: "#about", label: "About" },
  { href: "#education", label: "Education" },
  { href: "#contact", label: "Contact" }
];
---
<nav style="position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 1.5rem var(--edge-pad); backdrop-filter: blur(8px); background: color-mix(in srgb, var(--bg) 80%, transparent);">
  <a href="#hero" style="width: 32px; height: 32px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; color: var(--bg); font-weight: 700;">R</a>
  <div style="display: flex; gap: 2rem;">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
</nav>